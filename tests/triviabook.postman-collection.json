    },
    {
      "name": "Add a question and create a topic",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/triviabook/question/add",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"topic\": \"{{newTopic}}\", \"question\": \"What does CPU stand for?\", \"answer\": \"Central Processing Unit\", \"difficulty\": \"easy\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "/** Verify the expected HTTP response. */",
              "pm.test(\"HTTP 201\", function statusCode() { pm.response.to.have.status(201); });",
              "/** Verify that the updated list contains the inserted question. */",
              "pm.test(\"Updated topic list\", function updatedList() { pm.expect(pm.response.json().some(function matches(item) { return item.question === \"What does CPU stand for?\"; })).to.equal(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Read the new topic",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/triviabook/topic/{{newTopic}}",
        "header": []
